{
  "name": "article-relay",
  "version": "0.1.0",
  "private": true,
  "description": "微信公众号文章草稿同步工具",
  "main": "dist/main.js",
  "scripts": {
    "start": "npm run build && electron .",
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/relay.test.mjs",
    "build:mac": "npm run build && electron-builder --mac dir --publish never -c.mac.identity=- -c.mac.hardenedRuntime=false -c.mac.notarize=false",
    "build:mac:dmg": "npm run build && electron-builder --mac dmg --publish never",
    "build:win": "npm run build && electron-builder --win nsis --x64 --publish never"
  },
  "engines": { "node": ">=24" },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "electron": "^45.0.0",
    "electron-builder": "26.18.0",
    "typescript": "5.9.3"
  },
  "build": {
    "appId": "com.upupwork.articlerelay",
    "productName": "文章同步",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "ui/**/*", "package.json"],
    "mac": { "icon": "ui/icon.svg", "artifactName": "ArticleRelay-${version}-macOS-${arch}.${ext}" },
    "win": { "icon": "ui/icon.svg", "target": "nsis", "artifactName": "ArticleRelay-${version}-Windows-${arch}.${ext}" },
    "nsis": { "oneClick": false, "perMachine": false }
  }
}
